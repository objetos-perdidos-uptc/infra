# Copia a .env (lost.sh lo hace solo). No subas .env al repo.

# JWT: "CAMBIAME" se reemplaza solo por un valor aleatorio. Minimo 32 caracteres.
JWT_SECRET=CAMBIAME

# PostgreSQL
DB_NAME=lostfound
DB_USER=lostuser
DB_PASSWORD=lostpass
DB_PORT=5432

# MongoDB / Redis
MONGO_PORT=27017
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Notificaciones por correo (Brevo). Vacio = no se envian correos.
BREVO_API_KEY=
TEST_EMAIL_DESTINATION=